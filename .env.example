POLYGON_WALLET_PRIVATE_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
NEWSAPI_API_KEY=""

# === Copy-Trade Bot Configuration ===
# Polymarket profile URL of the trader to copy
COPY_TARGET_PROFILE_URL="https://polymarket.com/@k9Q2mX4L8A7ZP3R"
# Fallback: set the target's wallet address directly (optional, overrides profile URL)
COPY_TARGET_ADDRESS=""
# Maximum percentage of wallet balance per trade (0.05 = 5%)
MAX_TRADE_PCT="0.05"
# Hard cap: maximum USD per single trade (never exceeded, even if 5% is higher)
MAX_TRADE_USD="50.0"
# Circuit breaker: stop trading after this much spent in one day
MAX_DAILY_LOSS_USD="100.0"
# How often to check for new trades (seconds, minimum 10)
POLL_INTERVAL_SECONDS="30"
# Maximum acceptable slippage (0.02 = 2%)
MAX_SLIPPAGE_PCT="0.02"
# Set to "true" to log trades without executing them (RECOMMENDED for first run)
DRY_RUN="true"
# Audit log file path
COPYTRADE_LOG_FILE="copytrade_audit.log"
