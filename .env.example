POLYGON_WALLET_PRIVATE_KEY=""
OPENAI_API_KEY=""
TAVILY_API_KEY=""
NEWSAPI_API_KEY=""

# === Copy-Trade Bot Configuration ===
# Polymarket profile URL of the trader to copy
COPY_TARGET_PROFILE_URL=""
# Or set the target's wallet address directly
COPY_TARGET_ADDRESS="0xd0d6053c3c37e727402d84c14069780d360993aa"
# Maximum percentage of wallet balance per trade (0.05 = 5%)
MAX_TRADE_PCT="0.05"
# Hard cap: maximum USD per single trade (never exceeded, even if 5% is higher)
MAX_TRADE_USD="15.0"
# Circuit breaker: stop trading after this much spent in one day
MAX_DAILY_LOSS_USD="50.0"
# How often to check for new trades (seconds, minimum 10)
POLL_INTERVAL_SECONDS="30"
# Maximum acceptable slippage (0.02 = 2%)
MAX_SLIPPAGE_PCT="0.02"
# Set to "true" to log trades without executing them (RECOMMENDED for first run)
DRY_RUN="true"
# Audit log file path
COPYTRADE_LOG_FILE="copytrade_audit.log"
# Skip markets containing these keywords (comma-separated, case-insensitive)
# Example: "15 minutes,5 minutes" skips short-term arb markets
SKIP_MARKET_KEYWORDS="15 minutes,5 minutes"

# === Latency Arb Bot Configuration ===
# Coins to trade (comma-separated, must have 15-min up/down markets on Polymarket)
ARB_COINS="btc,eth,sol"
# Minimum price movement (%) on Binance to trigger a trade
ARB_MIN_MOVE_PCT="0.15"
# How many seconds of price history to compare (shorter = more sensitive)
ARB_LOOKBACK_SECONDS="60"
# Earliest second in the 15-min window to trade (skip first 60s)
ARB_MIN_WINDOW_SECONDS="60"
# Latest second in the 15-min window to trade (skip last 2 min)
ARB_MAX_WINDOW_SECONDS="780"
# Arb bot log file
ARBBOT_LOG_FILE="arbbot_audit.log"

# === Telegram Notifications (optional) ===
# Get these from @BotFather and @userinfobot on Telegram (see setup guide)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
